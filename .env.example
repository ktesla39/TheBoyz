# Public Microsoft OAuth application ID (not a client secret).
VITE_MICROSOFT_CLIENT_ID=00000000402b5328

# GitHub owner/repository used by the updater release configuration.
GITHUB_REPOSITORY=ktesla39/TheBoyz

# Public repository used for desktop release links.
VITE_GITHUB_REPOSITORY=ktesla39/TheBoyz
# Enabled by the signed release workflow after it prepares updater endpoints and keys.
VITE_TAURI_UPDATER_ENABLED=false

# Tauri updater signing credentials. Keep the private key and password secret.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_UPDATER_PUBLIC_KEY=

# Optional local development key; never prefix secrets with VITE_.
# Distributed builds require each user to save a key in Launcher Settings.
# A shared key embedded in a desktop app can be extracted from its binary.
CURSEFORGE_API_KEY=
