{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Boys",
  "version": "1.1.3",
  "identifier": "com.ktesla.tbl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Boys \u2014 Next-Gen Minecraft Launcher",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://skinsystem.ely.by https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: ws://localhost:3000; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ktesla39/TheBoyz/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
